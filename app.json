{
  "expo": {
    "name": "H-Budget",
    "slug": "h-budget",
    "scheme": "hbudget",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.ahmet.hbudget",
      "backgroundColor": "#FAF9F6"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
